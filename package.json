{
  "name": "obsidian-task-manager",
  "version": "1.0.0",
  "description": "A local-first task manager plugin for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "node deploy.mjs"
  },
  "keywords": ["obsidian", "obsidian-plugin", "task", "todo"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "typescript": "^5.4.0"
  }
}
